# ==============================================================================
# THE PETAL & BLOOM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# CRITICAL NOTICE:
# This project connects ONLY to the NEW ISOLATED SUPABASE PROJECT.
# NEVER enter the credentials of the live/production Supabase project here.
# ==============================================================================

# --- CLIENT-SIDE VARIABLES (Exposed to browser via Vite) ---
# Your NEW Supabase project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-new-project-ref.supabase.co

# Your NEW Supabase public anon key
VITE_SUPABASE_ANON_KEY=your_new_supabase_anon_key

# Public storefront URL (used for canonical SEO and social sharing)
VITE_SITE_URL=https://thepetalandbloom.vercel.app

# Cashfree client mode: 'TEST' (sandbox) or 'PRODUCTION'
VITE_CASHFREE_MODE=TEST

# --- SERVER-SIDE ONLY VARIABLES (Vercel Serverless Functions /api/*) ---
# NEVER expose these to the browser or prefix with VITE_

# Your NEW Supabase Service Role Key (full database access for backend APIs)
SUPABASE_SERVICE_ROLE_KEY=your_new_supabase_service_role_key

# Cashfree Payments API Credentials
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=SANDBOX

# Cashfree Webhook Secret (used to verify HMAC-SHA256 signatures on payment events)
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Shipping Integrations (Optional / Configurable)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=
