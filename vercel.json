{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/staff/(.*)", "destination": "/api/staff" },
    { "source": "/api/admin/staff", "destination": "/api/staff" },
    { "source": "/api/admin/orders/(.*)", "destination": "/api/orders" },
    { "source": "/api/orders/(.*)", "destination": "/api/orders" },
    { "source": "/api/checkout/(.*)", "destination": "/api/checkout" },
    { "source": "/api/coupons/(.*)", "destination": "/api/checkout" },
    { "source": "/api/payments/(.*)", "destination": "/api/payments" },
    { "source": "/api/assistance/(.*)", "destination": "/api/assistance" },
    { "source": "/api/reviews/(.*)", "destination": "/api/reviews" },
    { "source": "/api/account/(.*)", "destination": "/api/account" },
    { "source": "/api/admin/customers/(.*)", "destination": "/api/customers" },
    { "source": "/api/shipping/(.*)", "destination": "/api/shipping" },
    { "source": "/api/settings/(.*)", "destination": "/api/settings" },
    { "source": "/api/audit/(.*)", "destination": "/api/audit" },
    { "source": "/api/sitemap", "destination": "/api/settings" },
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
